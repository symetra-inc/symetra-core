# =============================================================================
# SERVIDOR
# =============================================================================

# Porta exposta pelo container (deve bater com o EXPOSE do Dockerfile)
PORT=3001

# =============================================================================
# CORS
# =============================================================================

# Origens permitidas, separadas por vírgula (sem espaço entre elas)
# Exemplo: https://meu-app.vercel.app,https://www.meu-dominio.com.br
CORS_ORIGINS=https://www.symetra.com.br/

# =============================================================================
# AUTH / JWT
# =============================================================================

# Segredo HS256 — NUNCA reutilize o valor de dev em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# =============================================================================
# SUPABASE / POSTGRES
# =============================================================================

# !! PRODUÇÃO: use o Transaction Pooler (porta 6543, pgbouncer=true) !!
# Supabase Dashboard → Project Settings → Database → Connection String → Transaction
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# URL direta (sem pooling) — usada pelo Prisma Migrate durante o deploy
# Supabase Dashboard → Project Settings → Database → Connection String → Direct
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# =============================================================================
# REDIS
# =============================================================================

# Use rediss:// (TLS) para Upstash em produção
# Upstash Console → Database → REST API → .env → UPSTASH_REDIS_REST_URL
REDIS_URL=rediss://:[password]@[host].upstash.io:6379

# =============================================================================
# OPENAI
# =============================================================================

OPENAI_API_KEY=sk-...

# =============================================================================
# META / WHATSAPP CLOUD API
# =============================================================================

META_WA_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# =============================================================================
# ASAAS (PAGAMENTOS PIX)
# =============================================================================

# !! PRODUÇÃO: use a URL de produção (sem "sandbox") !!
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# =============================================================================
# GOOGLE CALENDAR
# =============================================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# =============================================================================
# CRIPTOGRAFIA (LGPD)
# =============================================================================

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYMETRA_ENCRYPTION_KEY=
